@inproceedings{ref:pavone1994a,
	author			= {Pavone, D. R. and Desplans, J. P.},
	affiliation		= {},
	title			= {Application of High Sampling Rate Downhole Measurements for Analysis and Cure of Stick-Slip in Drilling},
	booktitle		= SPEANNUALTECHCONFERENCE,
	month			= {September},
	year			= {1994},
	volume			= {SPE Annual Technical Conference and Exhibition},
	pages			= {},
	organization	= {},
	address			= {},
	speid			= {SPE-28324-MS},
	doi				= {10.2118/28324-MS},
	url				= {https://doi.org/10.2118/28324-MS},
	href			= {https://onepetro.org/SPEATCE/proceedings-pdf/94SPE/94SPE/SPE-28324-MS/3490737/spe-28324-ms.pdf},
	note			= {},
	logline			= {},
	abstract		= {Optimal control of the drilling process requires that relevant physical models must be used while drilling. The reliability of these models must first be improved by comparing their results with actual downhole and surface data. Measurements of numerous drilling parameters and variables, sampled at high frequency, are then required. Trafor is an MWD system designed and operated by the Institut Fran\c{c}ais du P\'{e}trole for research on drill-string dynamics. It measures 15 downhole and 5 surface mechanical parameters. Because Trafor is fitted with an electric link adapted to rotary drilling, it transmits the downhole measurements to the surface in real time with a very high sampling rate of 1800 measurements per second. Furthermore, all the signals are fully synchronized. Hence, Trafor allows cross analysis between any signals, regardless of whether they are from downhole or from the surface. New data recorded in a 1060 m deep well exhibit stick-slip behavior for various weights-\``{o}n-bit and rotary speeds. Downhole data analysis coupled with numerical simulations shows that, in this field case, stick-slip occurred as an unstable drilling process. The origin of the instability lies in the relationship between the torque at the bit and the rotary speed. From this relationship, we can explain why stick-slip is known to disappear whenever the rotary speed (rpm) is increased or weight-on-bit is decreased. A stability analysis is used to derive operating conditions that prevent stick-slip. Simulations of drilling with adjusted PID or with a downhole ''anti sti\c{c}k-slip" tool are described. For both simulations, stick-slip can be cured.}
}











@inproceedings{ref:robson1993a,
	author			= {Robson, M. S. and Fambon, Luc and Sancho, Jean and Sutcliffe, B. C.},
	affiliation		= {},
	title			= {Benefits of Complementary Surface Vibration and MWD Drilling Mechanics Measurements in a Horizontal Well},
	booktitle		= SPEIADCDRILLINGCONFERENCEEXHBITION,
	month			= {February},
	year			= {1993},
	volume			= {SPE/IADC Drilling Conference},
	pages			= {},
	organization	= {},
	address			= {},
	speid			= {SPE-25689-MS},
	doi				= {10.2118/25689-MS},
	url				= {https://doi.org/10.2118/25689-MS},
	href			= {https://onepetro.org/SPEDC/proceedings-pdf/93DC/93DC/SPE-25689-MS/3732726/spe-25689-ms.pdf},
	note			= {},
	logline			= {},
	abstract		= {MWD measurements of weight on bit (WOB) and torque on bit (TOB) were used in conjunction with a surface drillstring vibration measurement sub to optimize drilling performance. This was performed in the horizontal section of a well drilled through fractured granitic basement below the normal producing zone of the Clair Field on the United Kingdom Continental Shelf. Experience shows that surface drillstring vibration and MWD measurements complement one another, thereby providing a more comprehensive understanding of drilling dynamics in real-time. In turn, having additional information on downhole conditions allows the operator increased confidence in interpretation of drilling events as the well is drilled. The downhole MWD tool provides measurements of torsional and axial strain. Due to MWD signal transmission rate limitations, the real-time data density is limited, and provides only a low frequency image of the drillstring behaviour. By contrast, the surface vibration sensors can use higher frequency measurements, although these may be less representative of conditions at or close to the bit. The combined data sets were used to successfully identify and monitor prognosed fracture zones, drillstring component wear and energy transfer to the bit. In addition, vibration data allowed the operator to modify drilling parameters to avoid harmful resonant conditions in the drillstring which could have resulted in MWD and bit failure. Evidence from this case study suggests that, with high frequency drillstring vibration measurements, the probability of detecting drilling problems using MWD drilling measurements can be much improved, leading to an overall increase in drilling efficiency and reduced costs.}
}





















@inproceedings{ref:wang2025a,
	author			= {Wang, Chunsheng and Lu, Junan and Wang, Zhe and Zou, Guanggui and Xia, Tianguo and Chen, Jianglin},
	affiliation		= {},
	title			= {Ultra-High Pressure Well Control Technology and Supporting Equipment for Ultra-Deep Carbonate Rock in Tarim Oilfield},
	booktitle		= SPEIASIAPACIFICCONFERENCE,
	month			= {October},
	year			= {2025},
	volume			= SPEIATMIASIAPACIFICCONFERENCE,
	pages			= {},
	organization	= {},
	address			= {},
	speid			= {SPE-226483-MS},
	doi				= {10.2118/226483-MS},
	url				= {https://doi.org/10.2118/226483-MS},
	href			= {https://onepetro.org/SPEAPOG/proceedings-pdf/25APOG/25APOG/D021S018R002/5271285/spe-226483-ms.pdf},
	note			= {D021S018R002},
	logline			= {},
	abstract		= {The exploration and development of Tarim Oilfield focuses on ultra-deep formations. Since 2021, more than 100 ultra-deep wells with a depth of 8000m have been completed. Ultra-deep drilling brings risks and challenges such as ultra-high pressure, ultra-high temperature, and high H2S. The highest formation pressure tested in Tarim Oilfield is 182MPa, and the highest H2S content is 41\texttimes{}104ppm. Ultra-deep carbonate rock ultra-high pressure well control treatment technology and supporting equipment for Tarim Oilfield were developed. Tarim Oilfield has taken various technical measures to solve the risk of ultra-high pressure well control. Firstly, in terms of engineering design, Tarim Oilfield has formed an integrated risk identification technology for ``five specials'' (special surface, special lithology, special geological phenomenon, special fluid, special temperature and pressure field), and adopted a comprehensive prediction technology for ``five pressures'' (pore pressure, collapse pressure, loss pressure, closure pressure and fracture pressure). Secondly, in in terms of well control technology, the application of dual density drilling, direct push logging, automatic filling, remote control center technologies successfully ensured the safe drilling of ultra-high pressure wells in this block. Finally, in terms of well control equipment, a new type of 140MPa all-metal casing head, large diameter integrated four-way, overflow one-click alarm well control equipment, 175MPa ultra-high pressure Christmas Tree and Blowout preventer (BOP) have been formed to achieve the essential safety of well control. The wellbore configuration optimization technology and ultra-high pressure well control equipment technology have been applied to 51 ultra-deep wells in the Tarim Oilfield. 140MPa well control equipment is used in the drilling process, including 140MPa casing head and blowout preventer. The 140MPa well killing manifold has a throttling function and the throttling valve adopts a wedge valve and is erosion-resistant. All 140MPa throttling manifolds use 140MPa gate valves to avoid using low-level gate valves on the outermost side. Remote control consoles with special shear gate control functions are promoted in high-risk areas. Compared with the more traditional complex overflow monitoring, the comprehensive Ultra-high pressure well control risk integrated identification technology can achieve early warning of complex overflows 10 minutes in advance. The drilling process combines the managed pressure drilling (MPD), pressure return method, and choke circulation killing have been successfully applied to deal with high casing pressure and complex overflow accidents in 17 wells, The maximum shut-in pressure was 47.57 MPa, and the maximum overflow disposal pressure was 64.4 MPa. Ultra-high pressure well control technology successfully ensures well control safety in the block and achieved high oil production. The promotion and application of ultra-high pressure well control risk management technology and supporting equipment in the Tarim Oilfield have provided excellent engineering cases and experience for the development of ultra-high pressure well control. This article also discusses the development trend of well control technology under extreme conditions.}
}

@article{ref:wang2026a,
	author			= {Wang, Xi and Peng, Fengjia and Zhang, Feifei and Sheng, Cancheng and Xiang, Jianbo and Lou, Wenqiang},
	title			= {A Temperature- and Pressure-Coupled Model for Surge Pressure in High-Temperature, High-Pressure Wells},
	journal			= {SPE Journal},
	volume			= {31},
	number			= {02},
	day				= {},
	month			= {February},
	year			= {2026},
	pages			= {876-890},
	organization	= {},
	speid			= {SPE-231444-PA},
	issn			= {1086-055X},
	doi				= {10.2118/231444-PA},
	url				= {https://doi.org/10.2118/231444-PA},
	href			= {},
	eprint			= {https://onepetro.org/SJ/article-pdf/31/02/876/5314335/spe-231444-pa.pdf},
	logline			= {},
	abstract		= {In high-temperature, high-pressure (HTHP) wells with a limited safety margin during tripping operations, modifications in the properties of drilling fluid within the well are substantial. Accurate prediction of surge and swab pressures is crucial for secure drilling operations. With this research, we introduce a method for improving surge pressure calculations through a predictive model for drilling fluid rheological parameters. The research investigates the actual condition of the opened-ended pipe (OEP) drillstring configuration beneath a 5-in. drillpipe, considering different yield stress, annular ratios, and tripping velocities. Findings indicate that when the annular ratio is below 0.55 or above 0.65, the drillstring configuration consistently results in either internal pipe blockage or annular blockage, regardless of the yield stress or annular ratio. This method can be extended to various drilling tool combinations through extensive data analysis, facilitating field assessment of drillstring conditions. Additionally, a systematic investigation was simultaneously done on the impact of sensitive parameters, including tripping speed, pump displacement, and annular size, on the surge pressure at the drill bit. The results suggest that accounting for temperature and pressure effects on drilling fluid characteristics may lead to an underestimation of computed surge pressure. In an OEP configuration, higher tripping speeds are feasible; in contrast, in a closed-ended pipe (CEP) configuration, activating the pump during tripping may reduce swab pressure. This study provides both theoretical and operational guidance for managing wellbore surge pressure across different drillstring configurations in HTHP wells, along with a novel approach for accurately predicting wellbore surge pressure.}
}














@article{ref:wu2020a,
	author			= {Xianzhu Wu and Fulei Wan and Zuo Chen and Liexiang Han and Zhilin Li},
	title			= {Drilling and completion technologies for deep carbonate rocks in the Sichuan Basin: Practices and prospects},
	journal			= NATGASB,
	volume			= {7},
	number			= {5},
	day				= {},
	month			= {},
	year			= {2020},
	pages			= {547-556},
	organization	= {},
	speid			= {},
	issn			= {2352-8540},
	doi				= {https://doi.org/10.1016/j.ngib.2020.09.012},
	url				= {https://www.sciencedirect.com/science/article/pii/S2352854020300930},
	href			= {},
	eprint			= {},
	logline			= {},
	abstract		= {The exploration and development of oil and gas resources in the Sichuan Basin is shifting to the deeper strata. The deep and ultra-deep wells in deep carbonate gas reservoirs are faced with many difficulties, such as multiple pressure systems, poor drillability, ultra-high pressure, ultra-high temperature and high sulfur content, which bring great challenges to drilling and completion engineering. In order to ensure the smooth exploration and development of deep carbonate oil and gas resources in the Sichuan Basin, the overall concept of combining field practice and technological research is followed. During the 13th Five-Year Plan, a batch of ultra-deep wells (well depth about 8000 m) have been drilled fast and safely (such as Well SYX133 in the Shuangyushi structure), and great progresses have been achieved in the experimental research of the support technologies in drilling and completion of deep and ultra-deep wells. And the achievements are as follows. First, the optimization of non-standard well structure, combined with the application of precisely managed pressure drilling technology and under-pressure plugging technology, lays a foundation for the optimized fast drilling and the safe reaching of geological targets. Second, a high-efficiency customized {PDC} drill bit is comprehensively optimized, popularized and applied, which effectively improves the average rate of penetration (ROP) in difficult-to-drill formations. Third, the development and application of drilling fluids (e.g. being resistant to high temperature of 200 \textdegree{}C and anti-composite brine) and active under-pressure plugging technology effectively reduces downhole complexities while drilling the complex formations, such as high temperature and high pressure brine and circulation loss. Fourth, when precisely managed pressure drilling and precisely managed pressure cementing methods are applied in the strata with a narrow density window, multiple pressure systems and pressure sensitivity, the average drilling and completion fluid loss is reduced by more than 90\%, and the complexity treatment time is cut down by more than 85\%, and the cementing quality pass rate is increased by more than 20\%. Fifth, the integrated application of ROP improvement technologies and tools (e.g. air drilling) results in a great reduction of drilling cycle and cost. It is concluded that the experimental research achievements provide basic support for the fast development of natural gas resources in the Anyue Gas Field, Sichuan Basin, and the great discovery of the Permian and Devonian natural gas resources in the northwestern Sichuan Basin. What's more, in order to adapt to the development of the deep natural gas (over 9000 m) in the Sichuan Basin during the 14th Five-Year Plan, it is necessary to speed up researches on drilling and completion technologies in nine aspects, e.g. high-temperature downhole tools and working fluid.},
	keywords		= {Sichuan basin, Carbonate gas reservoir, Deep and ultra-deep well, Drilling and completion technology, Optimization of well structure, Customized drill bit, High-quality drilling and completion fluid, Precisely managed pressure drilling}
}

@inproceedings{ref:xinming2014a,
	author			= {Xinming, Niu and Jinshuang, Zhang and Hui, Zhang},
	affiliation		= {},
	title			= {The Drilling Technologies of Ultra-deep High-Sour Gas Well in Northeast Sichuan Region of China},
	booktitle		= {World Petroleum Congress ({WPC})},
	month			= {June},
	year			= {2014},
	volume			= {21st World Petroleum Congress},
	pages			= {},
	organization	= {},
	address			= {},
	speid			= {},
	doi				= {},
	url				= {},
	href			= {https://onepetro.org/WPCONGRESS/proceedings-pdf/WPC21/WPC21/D043S007R002/1526622/wpc-21-0264.pdf},
	note			= {D043S007R002},
	logline			= {},
	abstract		= {There contains a large number of natural gas resources in Northeast Sichuan region of China where the SINOPEC has discovered two large gas fields in Puguang and Yuanba Area. These gas fields are characterized by deep buried depth, high formation pressure (equivalent density reached 2.5g/cm3), high hydrogen sulfide and carbon dioxide content (15.16\% H2S content and 8.64\% CO2 content in Puguang gas field) and multiple formation pressure system distribution. Especially in the upper continental formation, the drilling job is very hard to carry out for high formation pressure, high rock abrasiveness and stratum fracture development. The prominent problems include low rate of penetration, frequent circulation loss, horizontal well trajectory control, well control hazards and poor cementing quality etc. By applying the integrated matching technologies, such as well bore structure optimization, air/N2/foam drilling and composite drilling techniques, the ROP is substantially increased. Some measures such as plugging while drilling, bridging plugging and chemical gel plugging technologies are developed to solve the complex formation leakage problem. Cement quality has improved through the application of gas channeling prevention slurry and anti-acid gas corrosion slurry. The ultra-deep horizontal well drilling technologies also have become key technical method for the development of high-sour gas field. Since 2005, more than 100 wells were drilled with 100\% success ratio. Sinopec has gained a series of natural gas exploration achievements in the Northeast Sichuan Basin of China. The Puguang gas field is the first large un-compartmentalized high-sulfur marine gas reservoir which is a model of efficient exploration at domestic in recent years, and Yuanba gas field as well. These regions have complex geology conditions and the formation characteristics are as follows: First of all, gas reservoir is deeply buried, the geological structure is complex where distribute both continental and marine formations, the continental formation accounts for over 65\% of total depth. Next, the lithology of continental formation is tight, the rock is abrasive and the drillability grade in most formations is great than level 6. Thirdly, the formation pressure system is complex, and there are several different pressure gas-bearing beds where the pressure equivalent density reaches to 2.5g/cm2, and the marine formations in some regions also contain high-pressure salt-water or evaporite formations. Lastly, marine formations are characterized with high heterogeneity, high content of hydrogen sulfide and carbon dioxide. The H2S contentis 15.16\% and CO2 content is 8.64\% in Puguang gas field while 5.75\% H2S and 9.58\% CO2 in Yuanba gas field.}
}

@inproceedings{ref:yan2019a,
	author			= {Yan, Haibing and Li, Meiping and Wang, Chunquan and Liu, Yang and Liu, Wenzhong and Zhao, Qiyang },
	affiliation		= {},
	title			= {Cement Slurry System for the Long Open Hole Section of High-Pressure High-Temperature Deep Wells in the Sichuan Basin},
	booktitle		= {SPE Gas},
	month			= {October},
	year			= {2019},
	volume			= {SPE Gas \& Oil Technology Showcase and Conference},
	pages			= {},
	organization	= {},
	address			= {},
	speid			= {SPE-198581-MS},
	doi				= {10.2118/198581-MS},
	url				= {https://doi.org/10.2118/198581-MS},
	href			= {https://onepetro.org/SPEGOTS/proceedings-pdf/19GOTS/19GOTS/D031S018R001/1181991/spe-198581-ms.pdf},
	note			= {D031S018R001},
	logline			= {},
	abstract		= {The depth of natural gas wells in the Sichuan Basin ranges from 5500 m to 7500 m, the temperature of the target layer ranges from 140 \textdegree{}C to 160 \textdegree{}C, the pressure coefficient of the layer is 2.05\textasciitilde{}2.35, and the length of the open hole section is 2800 m to 4000m. The complex formation with multiple production layers and multiple leakage layers results in many challenges for well construction engineering. During cementing of a deep well, the challenges include high temperature and pressure, gas migration and leakage, and ``ultra-retardation'' at the top of the cement column when a cement slurry is used to address the problem oflong-interval isolation. To solve the complex technical problems encountered during cementing, a multi-function cement slurry system was developed for long-interval isolation at temperatures between 70 \textdegree{}C and 160 \textdegree{}C. The maximum compressive strength of the cement slurry at the top of the cement column with 4000m length was reached after 48 h and the cement slurry exhibited good leak-proof and anti-gas channeling performance. After mechanical modification, Young's modulus of the cement paste was lower than that of the conventional cement slurry (less than 6.0GPa) and the tensile strength of the cement paste was 30\% higher, exhibiting an improvement in the damage resistance of the cement sheath. The cement slurry system was successfully applied to more than 100 high-temperature high-pressure wells in the Sichuan Basin, reaching maximum values of 7793 m well depth, 3954 m length of the liner cementing section, 100 \textdegree{}C temperature difference, and 2.40 g/cm3 cement slurry density.}
}










@inproceedings{ref:zhang2025a,
	author			= {Zhang, Jiawei and Wang, Haige and Ji, Guodong and Cui, Meng and Chen, Lili and Li, Wenzhe and Liu, Li},
	affiliation		= {},
